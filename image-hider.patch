+package com.metrolist.shared.utils
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.produceState
+import kotlinx.coroutines.delay
+import java.io.File
+
+private fun imageHiderFlagFile(): File {
+    val appData = System.getenv("APPDATA")
+    val root = if (!appData.isNullOrBlank()) File(appData, "Metrolist") else File(System.getProperty("user.home"), ".config/metrolist")
+    return File(root, "hide-images.flag")
+}
+
+@Composable
+actual fun rememberImageHiderEnabled(): Boolean = produceState(imageHiderFlagFile().isFile) {
+    val flag = imageHiderFlagFile()
+    while (true) {
+        value = flag.isFile
+        delay(400)
+    }
+}.value
+
+actual fun setImageHiderEnabled(enabled: Boolean) {
+    val flag = imageHiderFlagFile()
+    if (enabled) {
+        flag.parentFile?.mkdirs()
+        flag.writeText("hide", Charsets.UTF_8)
+    } else {
+        flag.delete()
+    }
+}
